{
  "kind": "collectionType",
  "collectionName": "appointments",
  "info": {
    "singularName": "appointment",
    "pluralName": "appointments",
    "displayName": "Appointment",
    "description": "Advisor appointment requests submitted by customers through the website"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "fullName": {
      "type": "string",
      "required": true,
      "maxLength": 150
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true,
      "maxLength": 20
    },
    "preferredBranch": {
      "type": "string",
      "maxLength": 200
    },
    "preferredDate": {
      "type": "date"
    },
    "preferredTime": {
      "type": "enumeration",
      "enum": [
        "morning",
        "afternoon",
        "any"
      ],
      "default": "any"
    },
    "topicOfInterest": {
      "type": "string",
      "maxLength": 300
    },
    "additionalNotes": {
      "type": "text"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "confirmed",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "submittedAt": {
      "type": "datetime"
    }
  }
}
