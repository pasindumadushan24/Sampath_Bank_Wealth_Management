{
  "kind": "collectionType",
  "collectionName": "applications",
  "info": {
    "singularName": "application",
    "pluralName": "applications",
    "displayName": "Digital Application",
    "description": "Digital account opening and investment applications submitted through the website"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "fullName": {
      "type": "string",
      "required": true,
      "maxLength": 150
    },
    "nicOrPassport": {
      "type": "string",
      "required": true,
      "maxLength": 50
    },
    "phone": {
      "type": "string",
      "required": true,
      "maxLength": 20
    },
    "email": {
      "type": "email",
      "required": true
    },
    "dob": {
      "type": "date"
    },
    "nationality": {
      "type": "string",
      "maxLength": 50,
      "default": "Sri Lankan"
    },
    "address": {
      "type": "text",
      "required": true
    },
    "productName": {
      "type": "string",
      "required": true,
      "maxLength": 150
    },
    "investmentAmount": {
      "type": "decimal"
    },
    "preferredBranch": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "sourceOfFunds": {
      "type": "string",
      "maxLength": 100
    },
    "nomineeName": {
      "type": "string",
      "maxLength": 150
    },
    "nomineeNic": {
      "type": "string",
      "maxLength": 50
    },
    "nomineeRelationship": {
      "type": "string",
      "maxLength": 50
    },
    "referenceNumber": {
      "type": "string",
      "maxLength": 50
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "under-review",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "submittedAt": {
      "type": "datetime"
    },
    "pdfDownloadUrl": {
      "type": "string",
      "maxLength": 300
    }
  }
}
